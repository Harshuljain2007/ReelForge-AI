# GEMINI_API_KEY: Required for Gemini AI script planning, visual prompt engineering, and image generation (Phase 3+).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLOUD_TTS_KEY: Required for natural Hindi, English, and Hinglish voiceover synthesis (Phase 5).
GOOGLE_CLOUD_TTS_KEY=""

# VIDEO_PROVIDER_API_KEY: Required for AI image-to-video and text-to-video scene animation (Phase 5).
VIDEO_PROVIDER_API_KEY=""

# FIREBASE_PROJECT_ID: Configured during Firebase provisioning (Phase 2).
FIREBASE_PROJECT_ID=""
